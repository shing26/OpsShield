# OpsPilot 环境变量模板 —— 复制为 .env 并填入真实值。
# .env 已被 .gitignore 排除，任何真实凭据绝不写入源码/示例/测试。
# 本文件里的 change-me-* 全是示例占位：严格模式（OPSPILOT_STRICT=true）会拒绝占位 JWT 密钥。
DASHSCOPE_API_KEY=your-dashscope-key-here
JWT_SECRET=change-me-to-a-random-32-char-secret
# P3 中间件凭据（三容器认证；缺失时 docker compose 启动即报错）
REDIS_PASSWORD=change-me-redis
QDRANT_API_KEY=change-me-qdrant-key
ES_PASSWORD=change-me-elastic
# P2 账号体系（ADR-0005）：
# DEMO_PASSWORD —— 演示/验收账号统一口令（seed_demo_users.sh 与验收脚本读取）
# H2_DB_PASSWORD —— 用户主库（H2 文件库）口令；严格模式要求非空
DEMO_PASSWORD=change-me-demo-account-password
H2_DB_PASSWORD=change-me-h2-password

# ---- G0-W0.1 部署安全（2026-10-22 运维审查）----
# OPSPILOT_STRICT=true：生产形态声明。启动期硬校验 JWT 密钥强度（≥43 字符且非占位）、
# H2_DB_PASSWORD 非空、真实 DashScope 模型、STORAGE_MODE=live、监听地址非 0.0.0.0/::；
# 任一项不满足 → 启动失败并点名变量。本机演示保持 false。
OPSPILOT_STRICT=false
# 监听地址：默认 127.0.0.1（只给本机访问）。容器端口映射/前置反代才改 0.0.0.0，
# 且应同时把 OPSPILOT_ALLOW_PUBLIC_BIND 置 true 以通过 strict 校验。
SERVER_ADDRESS=127.0.0.1
# strict 下允许对 0.0.0.0/:: 绑定的逃生门（仅容器/反代形态需要）：默认 false=裸机安全侧
OPSPILOT_ALLOW_PUBLIC_BIND=false
# 告警人工出口（G1 2026-10-22 起支持常见 IM 自动识别；留空=落 logs/human-alerts.jsonl）
# auto 会按 URL 识别 Slack / 飞书自定义机器人 / 企微机器人；识别不了按 raw Alertmanager 转发。
OPSPILOT_HUMAN_CHANNEL=auto
# 示例：https://hooks.slack.com/services/...
#       https://open.feishu.cn/open-apis/bot/v2/hook/...
#       https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
OPSPILOT_HUMAN_WEBHOOK=
# 飞书自定义机器人若开启“签名校验”，把安全设置里的 secret 填这里；否则飞书回 code=19021。
OPSPILOT_FEISHU_SECRET=
# Telegram：BotFather 创建 bot 后填 token 与 chat_id；不填则不会走 telegram。
OPSPILOT_TELEGRAM_BOT_TOKEN=
OPSPILOT_TELEGRAM_CHAT_ID=
# 备份恢复：备份落盘目录与加密口令（留空=不加密；生产建议设置强口令）
BACKUP_DIR=backup
BACKUP_PASSPHRASE=

# ---- G1 运行面（2026-10-22 准入/缓存/SLO）----
# 全局与每租户 LLM 并发上限（ADR-0026）；超出立即 429 + Retry-After，不排队。
ADMISSION_GLOBAL_PERMITS=32
ADMISSION_TENANT_PERMITS=4
ADMISSION_RETRY_AFTER_SECONDS=1
# L2 语义缓存的 TTL 与有界上限；reingest 成功会清空，失败路径不动。
L2_TTL_HOURS=72
L2_MAX_ENTRIES=5000
# 发布标识（release.sh 注入；面板 /state.build.commit 与回滚对账用；缺省 unknown）
OPSPILOT_BUILD_COMMIT=

# ---- L1 受控恢复动作（ADR-0028；默认全关，红队全绿后按灰度开）----
# 总开关：false = propose/confirm/dispatch 全拒（回调豁免，在途 op 仍能收尾）
OPSPILOT_L1_ENABLED=false
# 灰度目标白名单（配置定义，非 K8s label——label 谁都能打）。空=全拒（fail-closed）
OPSPILOT_L1_ALLOWEDTARGETS=
# 派发 webhook（自动化系统侧；未配置=派发挂起在 confirmed）
OPSPILOT_L1_DISPATCHWEBHOOK=
# 派发密钥：生产用 _FILE 读挂载 Secret（K8s Secret / 600 文件），环境变量明文仅限开发
OPSPILOT_DISPATCH_KEY=
OPSPILOT_DISPATCH_KEY_FILE=
# 轮换窗口：旧 key 只验不签，回调不断流；轮换完成后清空
OPSPILOT_DISPATCH_KEY_PREVIOUS_FILE=
