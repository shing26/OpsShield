<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.opspilot</groupId>
  <artifactId>opspilot-gateway</artifactId>
  <version>1.0.0</version>
  <name>OpsPilot Gateway</name>
  <description>AIOps 智能排障与契约检索网关</description>

  <properties>
    <java.version>21</java.version>
    <redisson.version>4.8.0</redisson.version>
    <elasticsearch.version>8.14.3</elasticsearch.version>
    <qdrant.version>1.12.0</qdrant.version>
    <jjwt.version>0.13.0</jjwt.version>
    <!-- SCA 覆盖（Boot 4 基线，2026-10-27）：Trivy 对 Boot 4.1.1 默认版本报 3 CRITICAL + 10 HIGH；
         按同一主版本补丁升级（不改大版本）：Tomcat 11.0.24→11.0.25、Jackson2 2.21.5→2.22.3、
         Jackson3 3.1.5→3.2.3。属性名沿用 Boot 4 BOM 的 ${tomcat.version}/${jackson-2-bom.version}/${jackson-bom.version}。 -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-2-bom.version>2.22.3</jackson-2-bom.version>
    <jackson-bom.version>3.2.3</jackson-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Qdrant/ES 传递进来的 grpc-netty-shaded 不在 Boot BOM 管理；显式抬到修复版本。
           grpc-api 已在下方直接钉住，这里补 shaded transport，避免 Trivy 仍看到 1.65.1。 -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>1.75.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 显式声明：/actuator/health 是 demo.sh 预检与验收的存活判据，不得靠 redisson 的传递依赖 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 可观测性（OPS 6）：把 OpsMetrics 的 aiops.* 计数与派生比率暴露到 /actuator/prometheus。
         拉模型端点无凭证（JwtAuthFilter 只守 /api/v1/copilot|admin 与 /v1），由 Prometheus 抓取代办，
         生产多租部署时该端点应交给网络策略/scraper 凭证兜住（ADRs 0016）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- P2 账号体系：H2 文件库（主用户数据必须落盘，Redis 只存易失计数）+ JdbcTemplate + bcrypt。
         只引 spring-security-crypto 单工件，不拉整个 security 过滤器栈（鉴权仍由 JwtAuthFilter 承担）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <!-- compile：UserAdminCli 的 Restore 工具与网关 JDBC 都需要；fat jar 照常携带 -->
    </dependency>
    <!-- G1（2026-10-22）：schema 版本化。此前 CREATE TABLE IF NOT EXISTS 只能保证"表在"，
         无法回答"这库是哪一版"；加列/回滚/演练库对账都没有事实源。
         Boot 4 迁移（#8）：Flyway 12 把 H2 支持拆到 flyway-database-h2，且自动装配
         在独立模块 spring-boot-flyway（starter-jdbc 不再传递）——两者都要显式引入，
         否则启动期静默不迁移，表全缺（实测 ACTION_OPS not found）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Redis / Redisson -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
      <version>${redisson.version}</version>
    </dependency>

    <!-- Elasticsearch 8 Java Client -->
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
      <version>${elasticsearch.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <version>1.1.7</version>
    </dependency>

    <!-- Qdrant gRPC Client -->
    <dependency>
      <groupId>io.qdrant</groupId>
      <artifactId>client</artifactId>
      <version>${qdrant.version}</version>
    </dependency>
    <!-- qdrant client 的 protobuf/guava 为 runtime scope，编译期需显式引入 -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.36.2</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>32.1.3-android</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-api</artifactId>
      <version>1.85.0</version>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Ops Console build 指纹数据源（外审建议1，仅 Boot 自带 goal，不引第三方插件）：
               build-info.properties 进 jar 后 BuildProperties bean 提供 version/time；
               无文件（如 CI test 阶段）时控制器回退 "dev"/空串，面板照常渲染不报错。 -->
          <execution>
            <id>build-info</id>
            <goals><goal>build-info</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- B9（2026-09-22 补）：覆盖率产物 + 棘轮。报告绑 test 阶段（本项目 CI 跑的是
           mvn -B test 而不是 verify），产物落 target/site/jacoco/jacoco.xml；
           棘轮本身不在这里判定——那件事归 scripts/check_coverage.py，它读产物比门槛
           并把实测值打出来，比 jacoco:check 只给一句失败更有据可引。

           为什么本机量不到（已定位，不是配置错）：jacoco 的 destFile 会被解析成**绝对路径**
           （${project.build.directory}/jacoco.exec）。实测本仓目录名 `OpsPilot — AIOps`
           含长破折号（非 ASCII），该绝对路径经 cmd.exe 传给 -javaagent 时会被写坏，代理
           静默不落盘。对照矩阵（同一个代理、同一条命令）：相对路径 target/x.exec 写得出、
           ASCII 绝对路径写得出、含长破折号的绝对路径写不出（且文件没落到别处）。
           故本机要量覆盖率需把目录改成 ASCII 名；CI 的 runner 路径本就是 ASCII，不受影响。
           版本显式钉住：spring-boot-starter-parent 的 pluginManagement 并不管理它
           （不钉会报 'plugin.version is missing' 警告，且版本随 Maven 默认解析漂移）。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
