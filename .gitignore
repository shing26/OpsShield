# 构建产物
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# 环境与凭据（绝不入库）
.env
*.local

# IDE
.idea/
.vscode/
*.iml

# Python
offline/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 运行时产物（chunks.jsonl 与评测/压测报告按 ADR-0001 / DoD 需入库，不再排除）
logs/
*.log
# 并发曲线扫描的**原始** locust 产物：六档 × 五文件 = 30 个文件会淹掉 reports/，
# 而曲线的价值在汇总表（reports/concurrency_sweep.{json,md} 入库且内含复现命令），故原始件留本地。
offline/load/_sweep_raw/

# OS
Thumbs.db
.DS_Store

# 本地扫描状态
.mimosa/

# 生成物与凭据（均不入库）：
# - 红队畸形 token 由 JWT_SECRET 签名，可再生；合法账号走 login，不落盘
# - data/ 是 H2 用户主库（含 bcrypt 散列），凭据类，绝不入库
# - backup/ 是 users 备份 zip 与 audit 打包，同上
# - .zcode/ 是本地 agent 计划文件
scripts/redteam_tokens.txt
scripts/demo_tokens.txt
data/
backup/
.zcode/

# 历史归档区（清单见 _archive/README.md）：
# - 外部结构化评估报告，含"求职作品集"定性口径，公开见光稀释作品本身——不入仓，本机保留
#   （2026-09-13 grill 裁定默认）
# - 一次性演练产物（drill-container / s1-verify / qa-* 快照）
_archive/
.workbuddy/

# 录屏与预览图产物（docs/demo/）：**可再生**——它们录/拍的是本机活体栈，重来即可，
# 而二进制进公开仓只增体积不增证据力（证据在 offline/load/reports 与 audit.jsonl 里）。
# 脚本与讲解稿入库（DEMO.md §5「3 分钟一镜到底录屏讲解稿」），录/拍出来的东西不入库。
docs/demo/*.webm
docs/demo/*.png

# 编辑器本地忽略文件（ZCode）：与 .gitignore 同族的本机工具配置，不入库
.zcodeignore
